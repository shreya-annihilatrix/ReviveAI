# RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override DB paths (defaults shown)
# DB_PATH=reviveai.db
# GT_DB_PATH=ground_truth.db

# Optional: set degraded banks for bank_monitor (comma-separated)
# DEGRADED_BANKS=
# DOWN_BANKS=

# Optional: seed for reproducibility (default: 42)
# SEED=42
